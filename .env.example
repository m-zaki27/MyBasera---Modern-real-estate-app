# Copy to .env.local and fill in. Publishable keys only — these are bundled into the app.
# Never add a Clerk secret key or a Supabase service-role/secret key here.

# Clerk Dashboard → API Keys
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_your_key_here
